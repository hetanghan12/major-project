{
  "name": "Document Processing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "document-processing",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "webhookId": "doc-proc-webhook"
    },
    {
      "parameters": {
        "operation": "get",
        "collection": "uploads",
        "documentId": "={{$json.body.uploadId || $json.body.documentId}}"
      },
      "name": "Firestore: Get Status",
      "type": "n8n-nodes-base.googleFirestore",
      "typeVersion": 1,
      "position": [
        300,
        300
      ],
      "credentials": {
        "googleFirebaseAccount": {
          "id": "1",
          "name": "Firebase Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "value2": "cancelled"
            }
          ]
        }
      },
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "message": "Workflow stopped: Document was cancelled in Firestore."
      },
      "name": "Halt: Cancelled",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        700,
        200
      ]
    },
    {
      "parameters": {},
      "name": "Proceed: Processing",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "functionCode": "// Chunking Logic\nconst text = items[0].json.body.extractedText;\nconst chunkSize = 1000;\nconst overlap = 200;\n// ... chunking logic here ...\nreturn [{ json: { chunks: [] } }];"
      },
      "name": "Chunking",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "resource": "embedding",
        "model": "text-embedding-3-small",
        "input": "={{$json.chunks}}"
      },
      "name": "OpenAI Embedding",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        1100,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "upsert",
        "index": "cloud-space",
        "namespace": "={{$node[\"Webhook\"].json.body.userId}}",
        "vectors": "={{$json.embeddings}}"
      },
      "name": "Pinecone: Upsert",
      "type": "n8n-nodes-base.pinecone",
      "typeVersion": 1,
      "position": [
        1300,
        400
      ],
      "credentials": {
        "pineconeApi": {
          "id": "1",
          "name": "Pinecone Account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Firestore: Get Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firestore: Get Status": {
      "main": [
        [
          {
            "node": "Check Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status": {
      "main": [
        [
          {
            "node": "Halt: Cancelled",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Proceed: Processing",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Proceed: Processing": {
      "main": [
        [
          {
            "node": "Chunking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chunking": {
      "main": [
        [
          {
            "node": "OpenAI Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Embedding": {
      "main": [
        [
          {
            "node": "Pinecone: Upsert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "id": "1"
}
