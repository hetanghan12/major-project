# =============================================================
# Cloud Space Backend - Environment Configuration
# =============================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Comma-separated frontend origins allowed to call the API in production
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Shared secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
STATUS_ENDPOINT_TOKEN=your-secure-token-here
N8N_WEBHOOK_SECRET=your-secure-webhook-secret

# Rate limiting
RATE_LIMIT_MAX=300

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ENABLE_TEST_USER_ENDPOINT=false

# Firebase (service account JSON must be in config/)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# OpenAI / Pinecone (REQUIRED for AI features)
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=your-index-name

# AWS / S3 (REQUIRED for file storage)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Razorpay (optional - for payments)
RAZORPAY_KEY_ID=rzp_...
RAZORPAY_KEY_SECRET=...