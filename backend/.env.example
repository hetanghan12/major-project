NODE_ENV=production
PORT=3000

# Comma-separated frontend origins allowed to call the API in production
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Shared secrets
STATUS_ENDPOINT_TOKEN=replace-with-a-long-random-token
N8N_WEBHOOK_SECRET=replace-with-a-long-random-token

# Rate limiting
RATE_LIMIT_MAX=300

# Admin
ADMIN_EMAIL=admin@example.com
ENABLE_TEST_USER_ENDPOINT=false

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# OpenAI / Pinecone
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
