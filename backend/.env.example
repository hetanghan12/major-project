# =============================================================
# Cloud Space Backend - Environment Configuration
# =============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Pinecone Configuration (Vector Database)
# CRITICAL: Index must be configured with dimension=3072 for text-embedding-3-large
PINECONE_API_KEY=pcsk_3VMywv_9MYfX6dL4TBhcryWfefmGFAiPdL5CXPme4PiJM7PPwLTiqUmAe2ccHgMVcewRzx
PINECONE_INDEX_NAME=cloud-space
PINECONE_HOST=https://cloud-space-hbixkmf.svc.aped-4627-b74a.pinecone.io
PINECONE_ENVIRONMENT=us-east-1

# OpenAI Configuration (REQUIRED for document embeddings!)
# Model: text-embedding-3-large (3072 dimensions)
# Get your API key from https://platform.openai.com
OPENAI_API_KEY=

# AWS S3 Configuration (For File Storage)
# IMPORTANT: Make sure these match your actual AWS S3 bucket!
# Your bucket: docvault-dev-docs (Region: eu-north-1 / Stockholm)
#
# Get your credentials from AWS IAM Console:
# 1. Go to IAM → Users → Your User → Security credentials
# 2. Create Access Key
# 3. Copy the Access Key ID and Secret Access Key
#
# REQUIRED IAM PERMISSIONS for your user:
# - s3:PutObject (to upload files)
# - s3:GetObject (to download files)  
# - s3:DeleteObject (to delete files)
# On resource: arn:aws:s3:::docvault-dev-docs/*

AWS_ACCESS_KEY_ID=your_actual_access_key_id
AWS_SECRET_ACCESS_KEY=your_actual_secret_access_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=docvault-dev-docs

# Firebase Configuration (For Authentication and Firestore)
# Service account file should be placed at: backend/config/firebase-service-account.json
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# n8n Webhook URL (OPTIONAL - for AI chat processing)
# If set, AI queries will be processed through n8n workflow
# Leave empty to use direct OpenAI processing
N8N_WEBHOOK_URL=